+  /**
+   * Determines whether a vote should be created based on field settings.
+   *
+   * @param  \Drupal\Core\Entity\FieldableEntityInterface  $entity
+   *   The entity being voted on.
+   * @param  array  $field_settings
+   *   The field settings.
+   * @param  \Drupal\Core\Session\AccountInterface  $owner
+   *   The vote owner.
+   *
+   * @return bool
+   *   TRUE if vote should be created, FALSE otherwise.
+   */
+  protected function shouldCreateVote(
+    FieldableEntityInterface $entity,
+    array $field_settings,
+    $owner
+  ) {
+    // Check if user is allowed to vote on their own content.
+    if (!$field_settings['allow_ownvote']) {
+      if ($entity instanceof EntityOwnerInterface) {
+        // Don't allow vote if the voter is the entity owner.
+        if ($entity->getOwnerId() == $owner->id()) {
+          return FALSE;
+        }
+      }
+    }
+
+    return TRUE;
+  }
+
