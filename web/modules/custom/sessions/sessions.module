<?php

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\node\NodeInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Mail\MailManagerInterface;
use Drupal\Core\Messenger\MessengerInterface;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Drupal\Core\Url;
use Drupal\sessions\Form\TrackSuggestionForm;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_ENTITY_TYPE_insert().
 */
function sessions_node_insert(EntityInterface $entity): void
{
    // Check if the entity is a node and of type 'session'.
    if ($entity instanceof NodeInterface && $entity->bundle() == 'session') {
        // Clear all existing messages first.
        \Drupal::messenger()->deleteAll();

        // Display the success message.
        \Drupal::messenger()
          ->addStatus(t('Your session has been successfully submitted! You will receive an email when your session status has been updated.'));

        // Send confirmation email to the appropriate address.
        _sessions_send_submission_email($entity);
    }
}

/**
 * Sends a submission confirmation email for a session node.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The newly created session node.
 */
function _sessions_send_submission_email(NodeInterface $node): void
{
    $to = _sessions_get_recipient_email($node);

    if (empty($to)) {
        // Nothing to send to; log it so it doesn't fail silently.
        \Drupal::logger('sessions')->warning(
            'No recipient email found for session node @nid; submission email not sent.',
            ['@nid' => $node->id()]
        );
        return;
    }

    $mailManager = \Drupal::service('plugin.manager.mail');
    $module = 'sessions';
    $key = 'session_submission';
    $langcode = \Drupal::currentUser()->getPreferredLangcode();

    // During hook_node_insert, the pathauto alias may not exist yet.
    if (\Drupal::moduleHandler()->moduleExists('pathauto')) {
        \Drupal::service('pathauto.generator')->createEntityAlias($node, 'insert');
        \Drupal::service('path_alias.manager')->cacheClear();
    }

    $speaker_info = _sessions_get_speaker_info($node);

    $params = [
        'node' => $node,
        'title' => $node->getTitle(),
        'full_name' => _sessions_get_author_full_name($node),
        'cc_emails' => array_filter(array_column($speaker_info, 'email')),
        'session_url' => $node->toUrl('canonical', ['absolute' => TRUE])->toString(),
        'speaker_links' => $speaker_info,
    ];

    $send = true;
    $result = $mailManager->mail($module, $key, $to, $langcode, $params, NULL, $send);

    if (!$result['result']) {
        \Drupal::logger('sessions')->error(
            'Failed to send session submission email for node @nid to @email.',
            ['@nid' => $node->id(), '@email' => $to]
        );
    }
}

/**
 * Gets info for all speakers referenced on a session node.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The session node.
 *
 * @return array
 *   An array of ['name' => string, 'url' => string, 'email' => string|null]
 *   for each speaker.
 */
function _sessions_get_speaker_info(NodeInterface $node): array
{
    $speakers = [];

    foreach (_sessions_get_speaker_ids($node) as $speaker_id) {
        $speaker = \Drupal\node\Entity\Node::load($speaker_id);

        if (!$speaker) {
            continue;
        }

        $email = NULL;
        if ($speaker->hasField('field_email') && !$speaker->get('field_email')->isEmpty()) {
            $email = $speaker->get('field_email')->value ?: NULL;
        }

        $speakers[] = [
            'name' => $speaker->getTitle(),
            'url' => $speaker->toUrl('canonical', ['absolute' => TRUE])->toString(),
            'email' => $email,
        ];
    }

    return $speakers;
}

/**
 * Gets full name for node author for use in email body.
 *
 * Tries field_first_name / field_last_name on the user entity; falls back
 * to the account's display name if either field is missing or empty.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The session node.
 *
 * @return string
 *   A full name, or display name, to reference the submitter by.
 */
function _sessions_get_author_full_name(NodeInterface $node): string
{
    $author = $node->getOwner();

    if (!$author) {
        return t('Someone'); // Generic fallback if somehow there's no author.
    }

    $has_first = $author->hasField('field_first_name') && !$author->get('field_first_name')->isEmpty();
    $has_last = $author->hasField('field_last_name') && !$author->get('field_last_name')->isEmpty();

    if ($has_first && $has_last) {
        return $author->get('field_first_name')->value . ' ' . $author->get('field_last_name')->value;
    }

    if ($has_first) {
        return $author->get('field_first_name')->value;
    }

    // Fallback to display name (respects account name / "Display name" setting).
    return $author->getDisplayName();
}

/**
 * Determines the recipient email for a session submission.
 *
 * Prefers field_primary_contact if set; falls back to the
 * email of the node's author (the logged-in submitter).
 *
 * @param \Drupal\node\NodeInterface $node
 *   The session node.
 *
 * @return string|null
 *   The email address to send to, or NULL if none available.
 */
function _sessions_get_recipient_email(NodeInterface $node): ?string
{
    // Check the primary contact field first.
    if ($node->hasField('field_primary_contact') && !$node->get('field_primary_contact')->isEmpty()) {
        $email = $node->get('field_primary_contact')->value;
        if (!empty($email)) {
            return $email;
        }
    }

    // Fall back to the node author's account email.
    $author = $node->getOwner();
    if ($author && $author->getEmail()) {
        return $author->getEmail();
    }

    return NULL;
}

/**
 * Implements hook_mail().
 */
function sessions_mail($key, &$message, $params): void
{
    switch ($key) {
        case 'session_submission':

            if (!empty($params['cc_emails'])) {
                $message['headers']['Cc'] = implode(',', $params['cc_emails']);
            }
            $message['subject'] = t('Your session proposal has been received: @title', [
                '@title' => $params['title'],
            ]);
            $message['body'][] = t('@full_name has submitted "@title" to SCaLE.', [
                '@full_name' => $params['full_name'],
                '@title' => $params['title'],
            ]);
            $message['body'][] = t('View your session: @url', [
                '@url' => $params['session_url'],
            ]);
            if (!empty($params['speaker_links'])) {
                $speaker_lines = [];
                foreach ($params['speaker_links'] as $link) {
                    $speaker_lines[] = t('  - @name: @url', ['@name' => $link['name'], '@url' => $link['url']]);
                }
                $message['body'][] = t('Speaker profiles:') . "\n" . implode("\n", $speaker_lines);
            }
            $message['body'][] = t(
                "We appreciate your time and effort in crafting this talk proposal. You will be able to log back in and make edits to your proposal until the cfp deadline. Our program committee will begin reviewing proposals in September, and they may reach out to you with specific questions about your talk. You can expect to hear from us about whether your proposal was accepted by the end of November.\n\nIf you have questions, or wish to withdraw this proposal, please email cfp@socallinuxexpo.org.\n\nYou may also reach out to cfp@socallinuxexpo.org if you are a speaker but are unable to access the session link above. Alternatively, you may work through your session submitter to make edits.\n\n***\n\nSpeaker Agreement: By participating as a Speaker at the Event, I consent to the terms and conditions of this Agreement And Release.\n\nI will not be paid by the Linux Expo of Southern California for my services as Speaker, nor will my expenses be reimbursed by Linux Expo of Southern California unless I have a separate compensation or travel grant agreement regarding the Event. No fees will be paid on account of any reproduction or distribution of any materials that include any aspect of my participation in the Event.\n\nI will meet all deadlines for producing slides, materials, and other requirements.\n\nNeither I, nor my employer, may substitute another speaker in my place. If I cannot fulfill my commitment, the Event team will evaluate and approve any substitutions.\n\nThe Event is an educational event, not a sales or marketing platform. The Event is retaining me to provide an objective presentation that meets the educational needs of the Event attendees.\n\nEvent organizers and Linux Expo of Southern California may record, in any format, my participation in the Event; for distribution on their website via a creative commons license. On my own behalf and on behalf of my employer, I grant to the Event and its designees the irrevocable right to record, transcribe, modify, reproduce, perform, display, and distribute, in whole or in part and in any form and for any purpose, in any media now or subsequently known, my participation in the Event, and consent to the use of any text, other image, or sound in conjunction therewith. I further waive and release all claims and rights that may arise out of such use in any jurisdiction, now or in the future, and specifically waive any legal restrictions on waivers of future claims.\n\nI will release my slides for distribution via the SCALE conference website.\n\nI am over 18 years of age or have the consent of my parent or guardian to agree to the terms of this contract.\n\nThis Agreement And Release is governed by California law; choice of law rules do not apply, regardless of jurisdiction.\n\nI also agree to abide by the code of conduct, which can be found at https://www.socallinuxexpo.org/scale/24x/code-conduct\n\n",
            );
            break;

        case 'speaker_added':
            $message['subject'] = t("You've been added as a SCaLE speaker: @title", [
                '@title' => $params['title'],
            ]);
            $message['body'][] = t('You have been added as a SCaLE speaker to the talk "@title".', [
                '@title' => $params['title'],
            ]);
            $message['body'][] = t('View the session: @url', [
                '@url' => $params['session_url'],
            ]);
            if (!empty($params['speaker_links'])) {
                $speaker_lines = [];
                foreach ($params['speaker_links'] as $link) {
                    $speaker_lines[] = t('  - @name: @url', ['@name' => $link['name'], '@url' => $link['url']]);
                }
                $message['body'][] = t('Speaker profiles:') . "\n" . implode("\n", $speaker_lines);
            }

            $message['body'][] = t('Our program committee will begin reviewing proposals in September, and they may reach out to you with specific questions about your talk. You can expect to hear from us about whether your proposal was accepted by the end of November.');

            $message['body'][] = t('If you have questions, or wish to withdraw this proposal, please email cfp@socallinuxexpo.org.');

            $message['body'][] = t('You may also reach out to cfp@socallinuxexpo.org if you are a speaker but are unable to access the session link above. Alternatively, you may work through your session submitter to make edits.');

            $message['body'][] = t('***');

            $message['body'][] = t('To speak at SCaLE (and co-located events), one must agree to the following:');

            $message['body'][] = t('By participating as a Speaker at the Event, I consent to the terms and conditions of this Agreement And Release.');

            $message['body'][] = t('I will not be paid by the Linux Expo of Southern California for my services as Speaker, nor will my expenses be reimbursed by Linux Expo of Southern California unless I have a separate compensation or travel grant agreement regarding the Event. No fees will be paid on account of any reproduction or distribution of any materials that include any aspect of my participation in the Event.');

            $message['body'][] = t('I will meet all deadlines for producing slides, materials, and other requirements.');

            $message['body'][] = t('I will provide the organizers with my full legal name for conference records. If I explicitly request to be listed publicly under a different name (professional name, chosen name, etc), the organizers will do so if/where possible.');

            $message['body'][] = t('I will provide the organizers a recent photograph clearly showing my face and true likeness. Illustrations, avatars, cartoons, logos, heavily obscured or stylized images, and images of other people are not acceptable. Minimum resolution 800x1000 pixels; headshot or upper-body framing preferred.');

            $message['body'][] = t('I will attend and present in-person. SCaLE does not support remote presentations.');

            $message['body'][] = t('Neither I, nor my employer, may substitute another speaker in my place. If I cannot fulfill my commitment, the Event team will evaluate and approve any substitutions.');

            $message['body'][] = t('The Event is an educational event, not a sales or marketing platform. The Event is retaining me to provide an objective presentation that meets the educational needs of the Event attendees.');

            $message['body'][] = t('Event organizers and Linux Expo of Southern California may record, in any format, my participation in the Event; for distribution on their website via a creative commons license. On my own behalf and on behalf of my employer, I grant to the Event and its designees the irrevocable right to record, transcribe, modify, reproduce, perform, display, and distribute, in whole or in part and in any form and for any purpose, in any media now or subsequently known, my participation in the Event, and consent to the use of any text, other image, or sound in conjunction therewith. I further waive and release all claims and rights that may arise out of such use in any jurisdiction, now or in the future, and specifically waive any legal restrictions on waivers of future claims.');

            $message['body'][] = t('I will release my slides for distribution via the SCaLE conference website.');

            $message['body'][] = t('I am over 18 years of age or have the consent of my parent or guardian to agree to the terms of this contract.');

            $message['body'][] = t('This Agreement And Release is governed by California law; choice of law rules do not apply, regardless of jurisdiction.');

            $message['body'][] = t('I also agree to abide by the code of conduct, which can be found at https://www.socallinuxexpo.org/scale/24x/code-conduct');

            break;
    }
}

/**
 * Implements hook_node_update().
 */
function sessions_node_update(EntityInterface $entity): void
{
    // A track swap only changes the track, and the newest revision it edits
    // can differ from the live one, so comparing speakers could email people
    // who weren't added.
    if ($entity instanceof NodeInterface && $entity->bundle() == 'session' && empty($entity->sessionsTrackSwap)) {
        _sessions_notify_newly_added_speakers($entity);
    }

    if ($entity instanceof NodeInterface && $entity->bundle() == 'track_suggestion') {
        _sessions_apply_accepted_suggestion($entity);
    }
}

/**
 * Implements hook_node_presave().
 *
 * Enforces the track suggestion rules on every save, whichever form or script
 * it comes from. Anyone who can edit any track suggestion is treated as a
 * session editor, and only they can accept or reject.
 */
function sessions_node_presave(EntityInterface $entity): void
{
    if (!$entity instanceof NodeInterface || $entity->bundle() !== 'track_suggestion') {
        return;
    }

    $decision_fields = ['field_old_track', 'field_decision_note', 'field_reviewed_by', 'field_reviewed_on'];

    // New suggestions always start open, with nothing decided yet.
    if ($entity->isNew()) {
        $entity->set('field_swap_status', 'suggested');
        foreach ($decision_fields as $field) {
            $entity->set($field, NULL);
        }
        return;
    }

    $original = $entity->original;
    $was_open = $original->get('field_swap_status')->value === 'suggested';

    // Read before anything below resets these, so "nothing changed" can be
    // told apart from a real save. Drupal shows the same "has been updated"
    // message either way, which reads as if a decision happened when it
    // didn't. sessions_track_suggestion_edit_submit() uses this to fix that.
    $entity->trackSuggestionUnchanged =
        $entity->get('field_decision_note')->value === $original->get('field_decision_note')->value
        && $entity->get('field_swap_status')->value === $original->get('field_swap_status')->value;

    // A suggestion always stays on the talk it was made for.
    $entity->set('field_talk', $original->get('field_talk')->target_id);

    // Only the person who made it can change the track, and only while open.
    // Otherwise a session editor could accept a track the reviewer never
    // suggested.
    if (!$was_open || $entity->getOwnerId() != \Drupal::currentUser()->id()) {
        $entity->set('field_suggested_track', $original->get('field_suggested_track')->target_id);
    }

    $can_decide = $was_open && \Drupal::currentUser()->hasPermission('edit any track_suggestion content');
    $status = $entity->get('field_swap_status')->value;

    // Decisions are final, and only session editors make them. Anything else
    // keeps the status and decision fields as they were.
    if (!$can_decide || $status === 'suggested') {
        $note = $entity->get('field_decision_note')->getValue();

        $entity->set('field_swap_status', $original->get('field_swap_status')->value);
        foreach ($decision_fields as $field) {
            $entity->set($field, $original->get($field)->getValue());
        }

        // A session editor can leave a note on an open suggestion.
        if ($can_decide) {
            $entity->set('field_decision_note', $note);
        }
        return;
    }

    // Accepted or rejected just now.
    $entity->set('field_reviewed_by', \Drupal::currentUser()->id());
    $entity->set('field_reviewed_on', \Drupal::time()->getRequestTime());

    if ($status === 'accepted') {
        $talk = _sessions_latest_revision($entity->get('field_talk')->target_id);
        $entity->set('field_old_track', $talk ? $talk->get('field_session_track')->target_id : NULL);
    }
}

/**
 * Applies a suggestion that was just accepted. Called from hook_node_update().
 *
 * Moves the talk and closes the other open suggestions on it. This runs inside the same database transaction as the
 * accept, so if moving the talk fails the accept is rolled back too.
 */
function _sessions_apply_accepted_suggestion(NodeInterface $suggestion): void
{
    $was_open = $suggestion->original->get('field_swap_status')->value === 'suggested';
    if (!$was_open || $suggestion->get('field_swap_status')->value !== 'accepted') {
        return;
    }

    $new_tid = $suggestion->get('field_suggested_track')->target_id;
    $talk = _sessions_latest_revision($suggestion->get('field_talk')->target_id);

    if ($talk && $talk->get('field_session_track')->target_id != $new_tid) {
        $talk->set('field_session_track', $new_tid);

        // Saving a moderated node in code can drop it back to the default
        // state, so write the current state back explicitly. Same as #178.
        if ($talk->hasField('moderation_state')) {
            $talk->set('moderation_state', $talk->get('moderation_state')->value);
        }

        $talk->setNewRevision(TRUE);
        $talk->setRevisionUserId(\Drupal::currentUser()->id());
        $talk->setRevisionCreationTime(\Drupal::time()->getRequestTime());
        $talk->setRevisionLogMessage(t('Track changed by accepted track suggestion @nid.', ['@nid' => $suggestion->id()]));

        // Moving a talk isn't adding speakers, so don't email anyone.
        $talk->sessionsTrackSwap = TRUE;
        $talk->save();
    }

    // Close the other suggestions still open on this talk. Anything suggested
    // after this is a new round and stays open.
    $storage = \Drupal::entityTypeManager()->getStorage('node');
    $nids = $storage->getQuery()
        ->accessCheck(FALSE)
        ->condition('type', 'track_suggestion')
        ->condition('field_talk', $suggestion->get('field_talk')->target_id)
        ->condition('field_swap_status', 'suggested')
        ->condition('nid', $suggestion->id(), '<>')
        ->execute();

    foreach ($storage->loadMultiple($nids) as $other) {
        $other->set('field_swap_status', 'rejected');
        $other->set('field_decision_note', t('Another suggestion was accepted.'));
        $other->save();
    }
}

/**
 * Describes the most recent accepted swap for a talk, if it has been swapped.
 *
 * @return array|null
 *   The track it came from, the track it went to, and when the swap was
 *   decided. NULL if the talk has never been swapped.
 */
function _sessions_last_track_swap(NodeInterface $talk): ?array
{
    $storage = \Drupal::entityTypeManager()->getStorage('node');

    $nids = $storage->getQuery()
        ->accessCheck(FALSE)
        ->condition('type', 'track_suggestion')
        ->condition('field_talk', $talk->id())
        ->condition('field_swap_status', 'accepted')
        ->exists('field_old_track')
        ->exists('field_reviewed_on')
        ->sort('field_reviewed_on', 'DESC')
        ->range(0, 1)
        ->execute();

    if (!$nids) {
        return NULL;
    }

    $swap = $storage->load(reset($nids));
    $from = $swap->get('field_old_track')->entity;
    $to = $swap->get('field_suggested_track')->entity;

    if (!$from || !$to) {
        return NULL;
    }

    return [
        'from' => $from->label(),
        'to' => $to->label(),
        'on' => $swap->get('field_reviewed_on')->value,
    ];
}

/**
 * Loads the newest revision of a node, which may be ahead of the live one.
 *
 * Editing the live revision when a newer draft exists would bury the draft,
 * so track changes always start from the newest.
 */
function _sessions_latest_revision($nid): ?NodeInterface
{
    if (!$nid) {
        return NULL;
    }

    $storage = \Drupal::entityTypeManager()->getStorage('node');
    $vid = $storage->getLatestRevisionId($nid);

    return $vid ? $storage->loadRevision($vid) : NULL;
}

/**
 * Checks whether a suggestion can be accepted right now.
 *
 * @return string|null
 *   Why it can't, or NULL if it can.
 */
function _sessions_accept_problem(NodeInterface $suggestion): ?string
{
    $track = $suggestion->get('field_suggested_track')->entity;
    $talk = _sessions_latest_revision($suggestion->get('field_talk')->target_id);

    if (!$track || !$talk) {
        return (string) t('The talk or suggested track no longer exists.');
    }

    if ($talk->get('field_session_track')->target_id == $track->id()) {
        return (string) t('This talk is already in @track.', ['@track' => $track->label()]);
    }

    if ($track->hasField('field_active') && !$track->get('field_active')->value) {
        return (string) t('@track is no longer an active track.', ['@track' => $track->label()]);
    }

    return NULL;
}

/**
 * Notifies any speakers newly added to a session since its last save.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The updated session node.
 */
function _sessions_notify_newly_added_speakers(NodeInterface $node): void
{
    if (!isset($node->original)) {
        return;
    }

    $old_speaker_ids = _sessions_get_speaker_ids($node->original);
    $new_speaker_ids = _sessions_get_speaker_ids($node);

    $added_speaker_ids = array_diff($new_speaker_ids, $old_speaker_ids);

    if (empty($added_speaker_ids)) {
        return;
    }

    $mailManager = \Drupal::service('plugin.manager.mail');
    $langcode = \Drupal::currentUser()->getPreferredLangcode();

    foreach ($added_speaker_ids as $speaker_id) {
        $speaker = \Drupal\node\Entity\Node::load($speaker_id);

        if (!$speaker || !$speaker->hasField('field_email') || $speaker->get('field_email')->isEmpty()) {
            continue;
        }

        $email = $speaker->get('field_email')->value;

        if (empty($email)) {
            continue;
        }

        $params = [
            'node' => $node,
            'title' => $node->getTitle(),
            'session_url' => $node->toUrl('canonical', ['absolute' => TRUE])->toString(),
            'speaker_links' => _sessions_get_speaker_info($node),
        ];

        $result = $mailManager->mail('sessions', 'speaker_added', $email, $langcode, $params, NULL, TRUE);

        if (!$result['result']) {
            \Drupal::logger('sessions')->error(
                'Failed to send speaker-added email for node @nid to @email.',
                ['@nid' => $node->id(), '@email' => $email]
            );
        }
    }
}

/**
 * Gets the referenced speaker node IDs for a session node.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The session node.
 *
 * @return array
 *   An array of speaker node IDs (may be empty).
 */
function _sessions_get_speaker_ids(NodeInterface $node): array
{
    if (!$node->hasField('field_speakers_ref') || $node->get('field_speakers_ref')->isEmpty()) {
        return [];
    }

    return array_column($node->get('field_speakers_ref')->getValue(), 'target_id');
}

/**
 * Implements hook_comment_insert().
 * 
 * Redirects back to /review page after posting a comment or reply.
 */
function sessions_comment_insert(EntityInterface $entity) {
  _sessions_redirect_to_review($entity);
}

/**
 * Implements hook_form_alter().
 * 
 * When posting comment, redirect to /review.
 * Also adds speaker validation to session node forms.
 */
function sessions_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Handle posting comment, editing, replying, and delete.
  if ($form_id === 'comment_comment_form' || $form_id === 'comment_comment_delete_form') {
    $form['actions']['submit']['#submit'][] = '_sessions_comment_form_redirect_to_review';
  }
  
  // Add speaker validation to session node forms.
  if ($form_id === 'node_session_form' || $form_id === 'node_session_edit_form') {
    // Add custom validation handler.
    $form['#validate'][] = '_sessions_validate_speakers_field';
  }

  // The default forms for track suggestions. Only admins can add through them,
  // and only session editors reach the edit form, which is where they accept
  // or reject. These mirror the rules sessions_node_presave() enforces.
  if ($form_id === 'node_track_suggestion_form') {
    // New suggestions always start open, so there's nothing to decide yet.
    $form['field_swap_status']['#disabled'] = TRUE;
    $form['field_decision_note']['#access'] = FALSE;
  }

  if ($form_id === 'node_track_suggestion_edit_form') {
    $suggestion = $form_state->getFormObject()->getEntity();
    $is_open = $suggestion->get('field_swap_status')->value === 'suggested';
    $can_decide = $is_open && \Drupal::currentUser()->hasPermission('edit any track_suggestion content');

    // Changing these here would mean accepting something nobody suggested,
    // or rewriting the reviewer's own stated reason after the fact.
    $form['field_talk']['#disabled'] = TRUE;
    $form['field_suggested_track']['#disabled'] = TRUE;
    $form['field_swap_comment']['#disabled'] = TRUE;

    // Everyone can see the status and note, but decisions are final.
    $form['field_swap_status']['#disabled'] = !$can_decide;
    $form['field_decision_note']['#disabled'] = !$can_decide;

    // "Suggested" reads right on the badge reviewers see (describing their
    // own suggestion), but reads like a real option next to Accepted and
    // Rejected on this screen. Only reviewers ever see the badge, and only
    // session editors ever see this form, so the two never meet.
    if (isset($form['field_swap_status']['widget']['#options']['suggested'])) {
      $form['field_swap_status']['widget']['#options']['suggested'] = t('Pending');
    }

    if ($can_decide) {
      $form['#validate'][] = '_sessions_validate_track_decision';
    }

    // Runs after the default save, so it can fix the redirect and the
    // message the save already produced.
    $form['actions']['submit']['#submit'][] = '_sessions_track_suggestion_edit_submit';
  }

  // Populate vote_user for fivestar forms so display_format "user" works.
  if (strpos($form_id, 'fivestar_form') === 0 && isset($form['vote'])) {
    $context = $form_state->get('context');
    if ($context && isset($context['entity'])) {
      $entity = $context['entity'];
      $field_settings = $context['field_definition']->getSettings();
      $user_vote = _sessions_get_user_vote($entity, $field_settings['vote_type']);
      if ($user_vote !== NULL) {
        $form['vote']['#values']['vote_user'] = $user_vote;
        $form['vote']['#default_value'] = $user_vote;
      }
      $form['#cache']['max-age'] = 0;
    }
  }
}

/**
 * Validates accepting a track suggestion before anything is saved.
 *
 * Catches the talk already being in that track, or the track having gone
 * inactive since it was suggested.
 */
function _sessions_validate_track_decision(array &$form, FormStateInterface $form_state) {
  $status = $form_state->getValue(['field_swap_status', 0, 'value']);
  if ($status !== 'accepted') {
    return;
  }

  $suggestion = $form_state->getFormObject()->getEntity();
  if ($problem = _sessions_accept_problem($suggestion)) {
    $form_state->setErrorByName('field_swap_status', $problem);
  }
}

/**
 * Runs after a track suggestion's decision form saves.
 *
 * The default save always lands on the suggestion's own page and always says
 * "has been updated", even if nothing was actually decided. This sends the
 * reviewer back to the talk instead, and corrects the message when saving
 * genuinely changed nothing.
 */
function _sessions_track_suggestion_edit_submit(array &$form, FormStateInterface $form_state) {
  $suggestion = $form_state->getFormObject()->getEntity();

  // Every entity edit link gets a destination added automatically, which
  // always wins over a redirect set here unless told otherwise. The list's
  // own destination (return to the queue) is worth keeping; anything else is
  // the talk's plain page, since /review resolves to the same route as the
  // canonical one core builds that destination from. Send those back to the
  // review page instead, where the suggestion was actually decided from.
  $destination = \Drupal::request()->query->get('destination', '');

  if (!str_starts_with($destination, '/admin/content/track-swaps')) {
    $talk = $suggestion->get('field_talk')->entity;

    if ($talk) {
      $form_state->setRedirectUrl(Url::fromUserInput($talk->toUrl()->toString() . '/review'));
      $form_state->setIgnoreDestination(TRUE);
    }
  }

  if (!empty($suggestion->trackSuggestionUnchanged)) {
    \Drupal::messenger()->deleteByType(MessengerInterface::TYPE_STATUS);
    \Drupal::messenger()->addStatus(t('No changes made.'));
  }
}

/**
 * Custom submit handler to redirect session comments to /review page.
 */
function _sessions_comment_form_redirect_to_review(array &$form, FormStateInterface $form_state) {
  $comment = $form_state->getFormObject()->getEntity();
  
  if ($comment && $comment->getCommentedEntity()) {
    $commented_entity = $comment->getCommentedEntity();
    
    // For session comments, always redirect to /review.
    if ($commented_entity instanceof NodeInterface && $commented_entity->bundle() === 'session') {
      $review_url = $commented_entity->toUrl('canonical', ['absolute' => FALSE])->toString() . '/review';
      $form_state->setRedirectUrl(Url::fromUserInput($review_url));
    }
  }
}

/**
 * Helper function to redirect to /review page after posting a new comment.
 */
function _sessions_redirect_to_review(EntityInterface $entity) {
  $commented_entity = $entity->getCommentedEntity();
  
  // For session comments, always redirect to /review (no anchor).
  if ($commented_entity instanceof NodeInterface && $commented_entity->bundle() === 'session') {

    $review_url = $commented_entity->toUrl('canonical', ['absolute' => FALSE])->toString() . '/review';
    
    // Set the redirect response.
    $response = new RedirectResponse($review_url);
    $response->send();
    exit;
  }
}

/**
 * Gets the current user's vote value for an entity.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The voted entity.
 * @param string $vote_type
 *   The vote type machine name.
 *
 * @return float|null
 *   The vote value, or NULL if the user hasn't voted.
 */
function _sessions_get_user_vote(EntityInterface $entity, string $vote_type): ?float
{
    $uid = \Drupal::currentUser()->id();
    if (!$uid) {
        return NULL;
    }

    $vote_storage = \Drupal::entityTypeManager()->getStorage('vote');
    $vote_ids = $vote_storage->getQuery()
        ->condition('entity_type', $entity->getEntityTypeId())
        ->condition('entity_id', $entity->id())
        ->condition('type', $vote_type)
        ->condition('user_id', $uid)
        ->accessCheck(FALSE)
        ->execute();

    if (empty($vote_ids)) {
        return NULL;
    }

    $vote = $vote_storage->load(reset($vote_ids));
    return $vote ? (float) $vote->getValue() : NULL;
}

/**
 * Custom validation handler for session forms to check speakers field.
 */
function _sessions_validate_speakers_field(array &$form, FormStateInterface $form_state) {
  // Get the speakers field value.
  $speakers = $form_state->getValue('field_speakers_ref');
  
  // Check if speakers field is empty.
  // For IEF widgets, the target_id is stored as a concatenated string like "node:19396 node:19395"
  $is_empty = TRUE;
  if (!empty($speakers) && is_array($speakers)) {
    // Check if target_id exists and contains node references
    if (!empty($speakers['target_id'])) {
      $target_id_string = trim($speakers['target_id']);
      // Check if the string contains actual node references (not just empty or whitespace)
      if (!empty($target_id_string) && strpos($target_id_string, 'node:') !== FALSE) {
        $is_empty = FALSE;
      }
    }
  }
  
  // If speakers field is empty, show warning and rebuild form.
  if ($is_empty) {
    // Check if this is a second attempt (form was already rebuilt once).
    $warning_shown = $form_state->get('speaker_warning_shown');
    
    if ($warning_shown) {
      // Second attempt - user has confirmed by clicking save again, allow it to proceed.
      return;
    }
    
    // First attempt - show warning and rebuild form.
    $form_state->set('speaker_warning_shown', TRUE);
    $form_state->setRebuild(TRUE);
    
    // Show warning message to user.
    \Drupal::messenger()->addWarning(t('Warning: You are saving this session without any speakers assigned. If this is intentional, please click Save again to confirm.'));
  }
}

/**
 * Implements hook_ENTITY_TYPE_view_alter().
 *
 * Marks a session as read when it is viewed on its review page.
 *
 * Core only does this for the full view mode, see history_node_view_alter().
 * Reviewer comments are hidden on the full display and are read at
 * /node/{nid}/review, which view_mode_page renders in the admin_review mode,
 * so without this the new comment count on the votes report never clears.
 */
function sessions_node_view_alter(array &$build, EntityInterface $node, EntityViewDisplayInterface $display): void
{
    if ($display->getOriginalMode() !== 'admin_review') {
        return;
    }

    $build['#cache']['contexts'][] = 'user.roles:authenticated';

    if (\Drupal::currentUser()->isAuthenticated()) {
        $build['#attached']['library'][] = 'history/mark-as-read';
        $build['#attached']['drupalSettings']['history']['nodesToMarkAsRead'][$node->id()] = TRUE;
    }

    if ($node->bundle() === 'session') {
        _sessions_add_track_suggestions($build, $node);
    }
}

/**
 * Adds the track suggestions section to a talk's review page.
 *
 * Lists every suggestion made for the talk, then the form for making or
 * updating your own.
 */
function _sessions_add_track_suggestions(array &$build, NodeInterface $node): void
{
    $section = [
        '#type' => 'container',
        '#weight' => 50,
        '#attributes' => ['class' => ['my-7']],
        // The form is prefilled with the viewer's own suggestion, and the list
        // has to update as soon as anyone adds one.
        '#cache' => [
            'contexts' => ['user'],
            'tags' => ['node_list:track_suggestion'],
        ],
        'heading' => [
            '#markup' => '<h2>' . t('Track Suggestions') . '</h2>',
        ],
    ];

    if ($swap = _sessions_last_track_swap($node)) {
        $section['swap'] = [
            '#markup' => t('This talk was swapped from @from to @to on @date.', [
                '@from' => $swap['from'],
                '@to' => $swap['to'],
                '@date' => \Drupal::service('date.formatter')->format($swap['on'], 'custom', 'M j, Y'),
            ]),
            '#prefix' => '<p class="text-sm text-gray-500">',
            '#suffix' => '</p>',
        ];
    }

    $list = views_embed_view('track_swaps', 'block_1', $node->id());
    if ($list) {
        $section['list'] = $list;
    }

    // Its own permission, so reviewers don't need the Track suggestion content
    // permissions, which would also open Drupal's default forms that skip this
    // form's rules.
    if (\Drupal::currentUser()->hasPermission('suggest track changes')) {
        $section['form'] = \Drupal::formBuilder()->getForm(TrackSuggestionForm::class, $node);
    }

    $build['track_suggestions'] = $section;
}

/**
 * Implements hook_views_pre_render().
 *
 * The Reason and Decision note columns on the track swaps list rewrite
 * themselves into a <details>/<summary> for long text (see the view's
 * Rewrite results). This loads the one rule that trims the browser's
 * default bold styling on it. Scoped to this one view, same as
 * utility_views_pre_render().
 */
function sessions_views_pre_render(ViewExecutable $view): void
{
    if ($view->id() === 'track_swaps') {
        $view->element['#attached']['library'][] = 'sessions/track_swaps';
    }
}
