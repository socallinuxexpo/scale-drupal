<?php

use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme().
 *
 * This hook defines a custom theme hook for the module. It specifies the
 * `views_swiperjs` theme hook, which is used to render a custom Views template.
 *
 * @param array $existing
 *   An array of existing theme hooks.
 * @param string $type
 *   The type of hook being invoked.
 * @param string $theme
 *   The name of the theme.
 * @param string $path
 *   The path to the module implementing the hook.
 *
 * @return array
 *   An associative array of theme hooks.
 */
function views_plugins_theme($existing, $type, $theme, $path) {
  return [
    'views_swiperjs' => [
      'variables' => ['view' => NULL, 'rows' => NULL],
    ],
  ];
}

/**
 * Prepares variables for the `views_swiperjs` template.
 *
 * This preprocess function is used to prepare variables for the custom Views
 * template `views-swiperjs.html.twig`. It retrieves options for pagination,
 * navigation, and scrollbar from the view's style plugin and makes them
 * available to the template.
 *
 * @param array $variables
 *   An associative array containing:
 *   - view: The view object.
 *   - rows: An array of row items. Each row is an array of content.
 */
function views_plugins_preprocess_views_swiperjs(&$variables) {
  $view = $variables['view'];
  // Retrieve options from the view's style plugin.
  $pagination = $view->style_plugin->options['pagination'];
  $navigation = $view->style_plugin->options['navigation'];
  $scrollbar = $view->style_plugin->options['scrollbar'];

  // Call the default preprocess function for unformatted views.
  template_preprocess_views_view_unformatted($variables);

  // Add the retrieved options to the template variables.
  $variables['navigation'] = $navigation;
  $variables['scrollbar'] = $scrollbar;
  $variables['pagination'] = $pagination;
}

/**
 * Alters the exposed form for the `sessions` view.
 *
 * This hook modifies the exposed filter form for the `sessions` view with the
 * display ID `admin`. Specifically, it changes the `event` field to a select
 * dropdown and populates it with options based on nodes of type `event`.
 *
 * @param array $form
 *   The form array to be altered.
 * @param array $form_state
 *   The form state array.
 */
function views_plugins_form_views_exposed_form_alter(&$form, &$form_state) {
  if ($form['#id'] == 'views-exposed-form-session-votes-page-1') {
    if (isset($form['event']['#options'])) {
      $options = $form['event']['#options'];
      $all_option = [];
      if (isset($options['All'])) {
        $all_option['All'] = $options['All'];
        unset($options['All']);
      }
      $options = array_reverse($options, TRUE);
      $form['event']['#options'] = $all_option + $options;
    }

    _views_plugins_group_track_options($form);
  }

  if ($form['#id'] == 'views-exposed-form-sessions-admin') {
    // Remove the size attribute to convert the field to a dropdown.
    unset($form["event"]["#size"]);

    // Load all nodes of type 'event' to populate the dropdown options.
    $event_nodes = \Drupal::entityTypeManager()
      ->getStorage('node')
      ->loadByProperties(['type' => 'event']);

    $options = [];
    foreach ($event_nodes as $event_node) {
      $options[$event_node->id()] = $event_node->label();
    }
    natcasesort($options);
    $options = array_reverse($options, TRUE);

    // Set the field type to 'select' and assign the options.
    $form["event"]["#type"] = 'select';
    $form['event']['#options'] = $options;
  }
}

/**
 * Splits the Track filter options into Active and Inactive groups.
 *
 * The edit talk form already groups tracks this way, through the
 * GroupedSelectWidget in allowed_taxonomy. Views filters have no widget to
 * reuse, so the same split is done here on the options array instead.
 *
 * Unlike the widget, inactive tracks are always shown. The votes report can
 * load older events, so reviewers need them.
 *
 * @param array $form
 *   The exposed form for the session votes view.
 */
function _views_plugins_group_track_options(array &$form) {
  if (!isset($form['field_session_track_target_id_verf']['#options'])) {
    return;
  }

  $options = $form['field_session_track_target_id_verf']['#options'];

  // Keep "- Any -" at the top rather than sorting it into a group.
  $any_option = [];
  if (isset($options['All'])) {
    $any_option['All'] = $options['All'];
    unset($options['All']);
  }

  $terms = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_term')
    ->loadMultiple(array_keys($options));

  $active = [];
  $inactive = [];

  foreach ($options as $tid => $label) {
    $term = $terms[$tid] ?? NULL;

    if ($term && $term->hasField('field_active') && $term->get('field_active')->value) {
      $active[$tid] = $label;
    }
    else {
      $inactive[$tid] = $label;
    }
  }

  // A nested array renders as an optgroup, so each key becomes a heading.
  $form['field_session_track_target_id_verf']['#options'] = $any_option + array_filter([
    'Active' => $active ?: NULL,
    'Inactive' => $inactive ?: NULL,
  ]);
}

/**
 * Implements hook_views_data_alter().
 *
 * Registers the speaker name filter and the speaker emails field, on
 * node_field_data so they only appear on node based views.
 */
function views_plugins_views_data_alter(array &$data) {
  $data['node_field_data']['speaker_name'] = [
    'title' => t('Speaker name'),
    'help' => t('Filter content by the name of any referenced speaker.'),
    'filter' => [
      'id' => 'speaker_name',
    ],
  ];

  $data['node_field_data']['speaker_emails'] = [
    'title' => t('Speaker emails'),
    'help' => t('The email address of every speaker referenced by the content.'),
    'field' => [
      'id' => 'speaker_emails',
    ],
  ];
}
