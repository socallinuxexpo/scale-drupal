<div class="">

  <div class="mb-12 flex gap-3 items-center">
    {% if node.field_website.uri %}
      <div class="text-2xl">
        <a href="{{ node.field_website.uri }}" target="_blank" class="text-black" title="Website">
          <i class="fa-solid fa-globe"></i>
        </a>
      </div>
    {% endif %}

    {% if node.field_twitter_profile.uri %}
      <div class="text-2xl">
        <a href="{{ node.field_twitter_profile.uri }}" target="_blank" class="text-black" title="Twitter">
          <i class="fa-brands fa-x-twitter"></i>
        </a>
      </div>
    {% endif %}

    {% set social_icons = {
      'Mastodon': 'fa-mastodon',
      'X': 'fa-x-twitter',
      'Bluesky': 'fa-bluesky',
      'LinkedIn': 'fa-linkedin-in',
      'Facebook': 'fa-facebook-f',
      'Instagram': 'fa-instagram',
      'GitHub': 'fa-github',
    } %}
    {% for item in node.field_social_media_links %}
      {% set platform = item.entity.field_platform.entity.label %}
      {% set icon = social_icons[platform]|default('fa-share-nodes') %}
      <div class="text-2xl">
        <a href="{{ item.entity.field_url.uri }}" target="_blank" class="text-black" title="{{ platform }}">
          <i class="fa-brands {{ icon }}"></i>
        </a>
      </div>
    {% endfor %}
  </div>

  <div class="text-2xl mb-12">
    {{ drupal_field('body', 'node', node.id, {label: 'hidden'}) }}
  </div>

  <div class="mb-8">
    <div class="flex gap-5 items-center mb-8">
      <h2>Presentations</h2>
      {% if is_author %}
        {{ drupal_link('Propose a Session', '/node/add/session', { attributes: {class: 'px-3 py-1 rounded text-sm bg-primary text-white hover:bg-primary-600 hover:text-white'} }) }}
      {% endif %}
    </div>
    {{ drupal_view('speaker_sessions', 'embed', node.id) }}
  </div>

</div>
