{% set image_url = '' %}
{% if node.field_image is not empty %}
    {% set image_field = content.field_image[0] %}
    {% set image_url = image_field['#item'].entity.uri.value | image_style('wide') %}
{% endif %}

{% if node.field_hero_type.value == 'background_image' %}
    <div class="hero">
        <div class="hero__bg-img bg-cover bg-center relative text-white"
             style="background-image: url('{{ image_url }}')">
            <div class="absolute bg-black bg-opacity-50 h-full w-full"></div>
            <div class="absolute bg-gradient-to-t from-black to-transparent h-full w-full"></div>
        </div>

        <div class="hero__content container-fixed">
            <div class="hero__primary-lead p-component">
                <div class="flex h-full items-center relative">
                    <div class="content text-white">
                        <h1>{{ node.label }}</h1>
                        {% if node.field_primary_lead %}
                            {{ drupal_field('field_primary_lead', 'node', node.id, {label: 'hidden'}) }}
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="hero__secondary-lead">
                <div class="bg-black p-component text-white relative">
                    {% if node.field_secondary_lead %}
                        {{ drupal_field('field_secondary_lead', 'node', node.id, {label: 'hidden'}) }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% else %}
    {% set date = node.getCreatedTime|date('j M Y') %}

    {% embed 'scale:container' with {containerWidth: 'fixed'} %}
        {% block content %}
            <h1 class="">{{ node.label }}</h1>
            <div class="text-2xl mb-12">{{ date }}</div>

            <hr class="border border-black mb-7">
        {% endblock %}
    {% endembed %}
{% endif %}


<div class="">
    {{ drupal_field('field_components', 'node', node.id, {label: 'hidden'}) }}
</div>

