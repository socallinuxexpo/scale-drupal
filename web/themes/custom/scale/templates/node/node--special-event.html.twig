<div class="max-w-screen-lg mx-auto mb-8">
  {% if content.field_special_event_image %}
  <div class="mb-5">
    {{ content.field_special_event_image }}
  </div>
  {% endif %}
  <div class="">
    {{ drupal_field('body', 'node', node.id, {label: 'hidden'}) }}
  </div>
  <div class="">
    {% set start_date = content.field_when['#items'].0.value %}
    {% set end_date = content.field_when['#items'].0.end_value %}

    {% if start_date and end_date %}
      {{ start_date|date('l, F j, Y - H:i') }} to {{ end_date|date('H:i') }}
    {% elseif start_date %}
      {{ start_date|date('l, F j, Y - H:i') }} }}
    {% else %}
      {# Fallback text if the date range is missing #}
      Date range not available.
    {% endif %}
  </div>
</div>
