{% set name = [
  node.field_first_name.value,
  node.field_last_name.value
]|join(' ') %}

<div class="flex flex-row gap-4 flex-nowrap py-4 border-b border-black-50">
  <div class="flex-shrink-0 w-16">
    <a href="{{ drupal_url('node/' ~ node.id) }}" class="inline-block rounded-full overflow-hidden bg-gray-200">
      {{ content.field_profile_photo }}
    </a>
  </div>
  <div>
    <h3 class="">
      {{ name }}
    </h3>
    <div class="font-medium truncate">
      {{ node.field_job_title.value }}
    </div>
    <div class="text-sm truncate">
      {{ node.field_organization.value }}
    </div>
  </div>
  <div class="ms-auto">
    {{ drupal_link('Edit Speaker Profile', '/node/' ~ node.id ~ '/edit?destination=/user/' ~ user.id, { attributes: {class: 'px-3 py-1 rounded text-sm bg-primary text-white hover:bg-primary-600 hover:text-white'} }) }}
  </div>
</div>

