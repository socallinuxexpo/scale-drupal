{% embed 'scale:container' with {
  classes: 'bg-slate-100 p-7 mb-7 rounded-xl'
} %}
  {% block content %}
    <div>
      <h3 class="text-2xl font-bold leading-snug">
        {{ node.label }}
      </h3>

      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 py-3 text-sm text-slate-700">
        {# TODO: Pass this data via preprocessor #}
        {% set room = node.field_session_room.entity.label %}

        {#
        <div class="md:w-1/2">
          {{ start_date }} to {{ end_date }} - {{ room }}
        </div>
        #}

        <div class="md:w-1/2">
          {{ drupal_view('session_teaser_subhead', 'embed', node.id) }}
        </div>
      </div>

      <div class="text-base text-slate-800 leading-relaxed">
        {{ drupal_field('field_short_abstract', 'node', node.id, {label: 'hidden'}) }}
        {{ content.body }}
      </div>

      <div class="pt-5">
        <a href="{{ url }}" class="btn btn-black">
          See Presentation
        </a>
      </div>
    </div>
  {% endblock %}
{% endembed %}
