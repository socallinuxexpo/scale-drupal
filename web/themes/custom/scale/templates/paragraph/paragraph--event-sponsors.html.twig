{% if preprocessor.layout == 'grouped_grid' %}

    {% set content %}
        {{ preprocessor.content }}
    {% endset %}

    {% embed 'scale:container' %}
        {% block content %}
            {{ content }}
        {% endblock %}
    {% endembed %}

{% elseif preprocessor.layout == 'marquee' %}
    {% embed 'scale:container' %}
        {% block content %}
            {{ preprocessor.content }}
        {% endblock %}
    {% endembed %}
{% endif %}

