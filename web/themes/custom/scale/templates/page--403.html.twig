{% extends "page.html.twig" %}

{% block content %}
  <div class="text-center py-16">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-6xl font-bold text-gray-800 mb-4">403</h1>
      <h2 class="text-3xl font-semibold text-gray-700 mb-6">Access Denied</h2>
      <p class="text-lg text-gray-600 mb-8">
        Sorry, you don't have permission to access this page. You may need to log in to view this content.
      </p>

      <div class="flex justify-center gap-3">
        {% if not logged_in %}
          <a href="{{ path('user.login') }}" class="btn btn-primary">
            Log In
          </a>
        {% else %}
          <p class="text-gray-600 mb-4">You are logged in but don't have permission to access this page.</p>
        {% endif %}

        <a href="{{ front_page }}" class="btn btn-primary">
          Go to Homepage
        </a>
      </div>

      <div class="mt-12 text-sm text-gray-500">
        <p>If you believe you should have access to this page, please contact the site administrator.</p>
      </div>
    </div>
  </div>
{% endblock %}

