{% extends "page.html.twig" %}

{% block content %}
  <div class="access-denied text-center" style="max-width: 600px; margin: 4rem auto;">
    <h1>Access Denied</h1>
    <p>You don’t have permission to access this page.</p>

    {% if not logged_in %}
      <p>
        You might need to <a href="{{ path('user.login', {'destination': app.request.pathInfo}) }}">log in</a> to view this page.
      </p>
    {% else %}
      <p>
        <a href="{{ path('<front>') }}">Return to the home page</a>.
      </p>
    {% endif %}
  </div>
{% endblock %}
