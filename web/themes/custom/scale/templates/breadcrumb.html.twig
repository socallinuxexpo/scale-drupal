{#
/**
 * @file
 * Theme override for a breadcrumb trail.
 *
 * Available variables:
 * - breadcrumb: Breadcrumb trail items.
 */
#}
{% if breadcrumb %}
  <nav class="breadcrumb py-4" role="navigation" aria-labelledby="system-breadcrumb">
    <h2 id="system-breadcrumb" class="visually-hidden">{{ 'Breadcrumb'|t }}</h2>
    <ol class="breadcrumb__list flex gap-3">
      {% for item in breadcrumb %}
        <li class="breadcrumb__item">
          {% if item.url %}
            <a href="{{ item.url }}" class="breadcrumb__link">{{ item.text }}</a>
          {% else %}
            {{ item.text }}
          {% endif %}
        </li>
        {# Add a separator if this is not the last item #}
        {% if not loop.last %}
          <span class="breadcrumb__separator">/</span>
        {% endif %}
      {% endfor %}
    </ol>
  </nav>
{% endif %}
