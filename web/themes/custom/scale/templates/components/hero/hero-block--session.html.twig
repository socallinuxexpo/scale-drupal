{% extends 'hero-block.html.twig' %}


{% block hero__bottom %}
  {% if moderation_state_label %}
    <div class="mb-5">
      <span class="text-sm bg-blue-50 text-blue-500 py-1 px-3 font-body rounded">
        {{ moderation_state_label }}
      </span>
    </div>
  {% endif %}

  <div class="mb-12">
    {{ content.speakers }}
  </div>

  <div class="flex items-center gap-3">

    {% if node.field_session_level.value %}
      {% embed 'scale:badge' %}
        {% block text %}
          Audience: {{ node.field_session_level.entity.label }}
        {% endblock %}
      {% endembed %}
    {% endif %}

    {% if node.field_session_track.value %}
      {% embed 'scale:badge' %}
        {% block text %}
          Topic: {{ node.field_session_track.entity.label }}
        {% endblock %}
      {% endembed %}
    {% endif %}
  </div>

{% endblock %}
