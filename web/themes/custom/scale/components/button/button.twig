{% set color = color ?? 'primary' %}
{% set size = size ?? '' %}

{% set classes = [
  'btn',
  'btn-' ~ color,
  size ? 'btn-' ~ size : '',
] %}

{% set attributes = create_attribute() %}

<button{{ attributes.addClass(classes) }}>
  {% block button_text %}
    {{ button_text }}
  {% endblock %}
</button>


